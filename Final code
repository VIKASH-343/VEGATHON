// ---------------- CRC8 ----------------
uint8_t crc8(const String &s) {
  uint8_t crc = 0x00;
  for (size_t i = 0; i < s.length(); i++) {
    crc ^= (uint8_t)s[i];
    for (uint8_t b = 0; b < 8; b++) {
      if (crc & 0x80) crc = (uint8_t)((crc << 1) ^ 0x07);
      else             crc = (uint8_t)(crc << 1);
    }
  }
  return crc;
}

// ---------------- Float formatting (no dtostrf dependency) ----------------
String floatToStr(float value, uint8_t decimals) {
  bool neg = value < 0;
  if (neg) value = -value;

  unsigned long scale = 1;
  for (uint8_t i = 0; i < decimals; i++) scale *= 10;

  unsigned long scaled = (unsigned long)(value * scale + 0.5);
  unsigned long intPart = scaled / scale;
  unsigned long fracPart = scaled % scale;

  String s = neg ? "-" : "";
  s += String(intPart);
  if (decimals > 0) {
    String fracStr = String(fracPart);
    while (fracStr.length() < decimals) fracStr = "0" + fracStr;
    s += "." + fracStr;
  }
  return s;
}

// ---------------- SOS button check (non-blocking) ----------------
void checkSosButton() {
  bool currentReading = digitalRead(BUTTONPIN);

  if (currentReading != lastButtonReading) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > DEBOUNCE_DELAY) {
    static bool stableState = HIGH;

    if (currentReading != stableState) {
      stableState = currentReading;

      if (stableState == LOW) {
        sosActive = !sosActive;
        digitalWrite(BUZZERPIN, sosActive ? HIGH : LOW);
        Serial.println(sosActive ? "[aries] SOS ACTIVE - buzzer ON" : "[aries] SOS cleared - buzzer OFF");
      }
    }
  }

  lastButtonReading = currentReading;
}

// ---------------- DHT11 bit-bang read ----------------
int waitForLevel(int level, unsigned long timeout) {
  unsigned long start = micros();
  while (digitalRead(DHTPIN) != level) {
    if (micros() - start > timeout) return -1;
  }
  return micros() - start;
}

int readDHT11(float *temperature, float *humidity) {
  uint8_t bits[5] = {0, 0, 0, 0, 0};

  pinMode(DHTPIN, OUTPUT);
  digitalWrite(DHTPIN, LOW);
  delay(20);
  digitalWrite(DHTPIN, HIGH);
  delayMicroseconds(30);
  pinMode(DHTPIN, INPUT);

  if (waitForLevel(LOW, DHT_TIMEOUT) == -1) return -1;
  if (waitForLevel(HIGH, DHT_TIMEOUT) == -1) return -1;
  if (waitForLevel(LOW, DHT_TIMEOUT) == -1) return -1;

  for (int i = 0; i < 40; i++) {
    if (waitForLevel(HIGH, DHT_TIMEOUT) == -1) return -1;
    int highTime = waitForLevel(LOW, DHT_TIMEOUT);
    if (highTime == -1) return -1;

    bits[i / 8] <<= 1;
    if (highTime > 40) {
      bits[i / 8] |= 1;
    }
  }

  uint8_t checksum = bits[0] + bits[1] + bits[2] + bits[3];
  if (checksum != bits[4]) return -2;

  *humidity    = bits[0];
  *temperature = bits[2];
  return 0;
}

String classifyLevel(float v, float emergLow, float critLow, float warnLow,
                      float warnHigh, float critHigh, float emergHigh) {
  if (v <= emergLow || v >= emergHigh) return "EMERGENCY";
  if (v <= critLow  || v >= critHigh)  return "CRITICAL";
  if (v <= warnLow  || v >= warnHigh)  return "WARNING";
  return "NORMAL";
}

// ---------------- MQ135 read + classification ----------------
int readAverageADC(int pin, int samples) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(5);
  }
  return sum / samples;
}

float getTWA() {
  float sum = 0;
  for (int i = 0; i < twaCount; i++) sum += twaBuffer[i];
  return sum / twaCount;
}

String readMQ135(float *instantPPMOut, float *twaPPMOut) {
  int rawADC = readAverageADC(MQ135_PIN, 10);

  bool sensorFault = (rawADC >= (int)(ADC_MAX_RAW - 5));

  float voltage = rawADC * (MQ135_VCC / ADC_MAX_RAW);
  float RS = 999999;
  if (voltage > 0.05) {
    RS = ((MQ135_VCC - voltage) / voltage) * MQ135_RL;
  }

  float ratio = RS / R0;
  if (ratio < MIN_RATIO) ratio = MIN_RATIO;

  float instantPPM = MQ_PARA * pow(ratio, MQ_PARB);
  if (instantPPM > MAX_PPM) instantPPM = MAX_PPM;
  if (sensorFault) instantPPM = MAX_PPM;

  twaBuffer[twaIndex] = instantPPM;
  twaIndex = (twaIndex + 1) % TWA_BUFFER_SIZE;
  if (twaCount < TWA_BUFFER_SIZE) twaCount++;

  float twaPPM = getTWA();

  *instantPPMOut = instantPPM;
  *twaPPMOut = twaPPM;

  if (sensorFault) return "EMERGENCY";
  if (instantPPM >= IDLH_LIMIT) return "EMERGENCY";
  if (instantPPM >= STEL_LIMIT) return "EMERGENCY";

  if (twaCount < MIN_SAMPLES_FOR_TWA) {
    if (instantPPM >= PEL_TWA) return "CRITICAL";
    if (instantPPM >= 1000)    return "WARNING";
    return "NORMAL";
  }

  if (twaPPM >= PEL_TWA) return "CRITICAL";
  if (twaPPM >= 1000)    return "WARNING";
  return "NORMAL";
}

void calibrateR0() {
  Serial.println("Calibrating R0... keep sensor in clean, ventilated air.");
  float rsSum = 0;
  const int samples = 50;
  for (int i = 0; i < samples; i++) {
    int raw = readAverageADC(MQ135_PIN, 10);
    float voltage = raw * (MQ135_VCC / ADC_MAX_RAW);
    float rs = 999999;
    if (voltage > 0.05) {
      rs = ((MQ135_VCC - voltage) / voltage) * MQ135_RL;
    }
    rsSum += rs;
    Serial.print("Sample "); Serial.print(i + 1);
    Serial.print("/"); Serial.print(samples);
    Serial.print(" -- raw ADC: "); Serial.print(raw);
    Serial.print(", RS: "); Serial.println(rs);
    delay(1000);
  }
  float rsAvg = rsSum / samples;
  float ratioAtBaseline = pow(CLEAN_AIR_PPM / MQ_PARA, 1.0 / MQ_PARB);
  float newR0 = rsAvg / ratioAtBaseline;

  Serial.println("---- Calibration complete ----");
  Serial.print("Measured RS avg: "); Serial.println(rsAvg);
  Serial.print("Suggested R0: "); Serial.println(newR0);
  Serial.println("Copy this R0 value into the code, set RUN_CALIBRATION = false, and re-upload.");
}

// ---------------- ADXL345 ----------------
void writeRegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(ADXL345_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

uint8_t readRegister(uint8_t reg) {
  Wire.beginTransmission(ADXL345_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(ADXL345_ADDR, (uint8_t)1);
  if (Wire.available()) return Wire.read();
  return 0xFF;
}

void readAccel(float &gx, float &gy, float &gz) {
  Wire.beginTransmission(ADXL345_ADDR);
  Wire.write(REG_DATAX0);
  Wire.endTransmission(false);
  Wire.requestFrom(ADXL345_ADDR, (uint8_t)6);

  int16_t rawX = Wire.read() | (Wire.read() << 8);
  int16_t rawY = Wire.read() | (Wire.read() << 8);
  int16_t rawZ = Wire.read() | (Wire.read() << 8);

  const float SCALE = 0.0039;
  gx = rawX * SCALE;
  gy = rawY * SCALE;
  gz = rawZ * SCALE;
}

void calibrateVerticalAxis() {
  Serial.println("Calibrating vertical axis -- keep device still in its normal worn orientation...");
  float sumX = 0, sumY = 0, sumZ = 0;
  for (unsigned long i = 0; i < BASELINE_SAMPLES; i++) {
    float gx, gy, gz;
    readAccel(gx, gy, gz);
    sumX += gx; sumY += gy; sumZ += gz;
    delay(20);
  }
  float avgX = sumX / BASELINE_SAMPLES;
  float avgY = sumY / BASELINE_SAMPLES;
  float avgZ = sumZ / BASELINE_SAMPLES;

  float absX = fabs(avgX), absY = fabs(avgY), absZ = fabs(avgZ);
  if (absX >= absY && absX >= absZ) {
    verticalAxisIndex = 0; verticalBaseline = avgX;
  } else if (absY >= absX && absY >= absZ) {
    verticalAxisIndex = 1; verticalBaseline = avgY;
  } else {
    verticalAxisIndex = 2; verticalBaseline = avgZ;
  }

  Serial.print("Vertical axis = ");
  Serial.print(verticalAxisIndex == 0 ? "X" : (verticalAxisIndex == 1 ? "Y" : "Z"));
  Serial.print(", baseline = ");
  Serial.print(verticalBaseline, 3);
  Serial.println("g");
}

// ---------------- MAX30100 manual FIFO reading ----------------
uint8_t readMaxReg(uint8_t reg) {
  Wire.beginTransmission(MY_MAX30100_ADDR);
  Wire.write(reg);
  uint8_t err = Wire.endTransmission(false);
  if (err != 0) return 0xFF;
  Wire.requestFrom((int)MY_MAX30100_ADDR, 1);
  if (Wire.available()) return Wire.read();
  return 0xFE;
}

void clearInterruptStatus() {
  readMaxReg(MY_REG_INT_STATUS);
}

bool readMaxFifoSample(uint16_t *ir, uint16_t *red) {
  uint8_t wr  = readMaxReg(MY_REG_FIFO_WR_PTR);
  uint8_t rd  = readMaxReg(MY_REG_FIFO_RD_PTR);
  uint8_t ovf = readMaxReg(MY_REG_OVF_COUNTER);

  uint8_t numSamples = (wr - rd) & 0x0F;
  if (numSamples == 0 && ovf > 0) {
    numSamples = 16;
  }
  if (numSamples == 0) return false;

  Wire.beginTransmission(MY_MAX30100_ADDR);
  Wire.write(MY_REG_FIFO_DATA);
  uint8_t err = Wire.endTransmission(false);
  if (err != 0) {
    Serial.print("[i2c-error] FIFO_DATA transmission failed, err="); Serial.println(err);
    return false;
  }
  uint8_t got = Wire.requestFrom((int)MY_MAX30100_ADDR, 4);
  if (got < 4) {
    Serial.print("[i2c-error] requestFrom got only "); Serial.println(got);
    return false;
  }

  uint8_t irMsb  = Wire.read();
  uint8_t irLsb  = Wire.read();
  uint8_t redMsb = Wire.read();
  uint8_t redLsb = Wire.read();

  *ir  = ((uint16_t)irMsb  << 8) | irLsb;
  *red = ((uint16_t)redMsb << 8) | redLsb;
  return true;
}

void resetDetection() {
  irMax = 0; irMin = 65535;
  redMax = 0; redMin = 65535;
  thresholdHigh = 0; thresholdLow = 0;
  peakDetected = false;
  t1 = 0; t2 = 0;
  bpmIndex = 0; bpmCount = 0;
  spo2Index = 0; spo2Count = 0;
  lastRangeUpdate = millis();
}

float getAverageBPM() {
  float sum = 0;
  for (int i = 0; i < bpmCount; i++) sum += bpmReadings[i];
  return bpmCount ? sum / bpmCount : 0;
}

float getAverageSpO2() {
  float sum = 0;
  for (int i = 0; i < spo2Count; i++) sum += spo2Readings[i];
  return spo2Count ? sum / spo2Count : 0;
}

void updateRange(uint16_t irValue, uint16_t redValue) {
  if (irValue > irMax) irMax = irValue;
  if (irValue < irMin) irMin = irValue;
  if (redValue > redMax) redMax = redValue;
  if (redValue < redMin) redMin = redValue;

  if (millis() - lastRangeUpdate > RANGE_RESET_INTERVAL) {
    uint16_t irRange = irMax - irMin;
    uint16_t redRange = redMax - redMin;

    if (irRange > 50) {
      thresholdHigh = irMin + (irRange * 0.6);
      thresholdLow  = irMin + (irRange * 0.4);
    }

    if (irRange > 50 && redRange > 5) {
      float AC_IR  = irRange;
      float DC_IR  = (irMax + irMin) / 2.0;
      float AC_RED = redRange;
      float DC_RED = (redMax + redMin) / 2.0;

      float R = (AC_RED / DC_RED) / (AC_IR / DC_IR);
      float SpO2 = 110.0 - 25.0 * R;
      if (SpO2 > 100) SpO2 = 100;
      if (SpO2 < 0) SpO2 = 0;

      spo2Readings[spo2Index] = SpO2;
      spo2Index = (spo2Index + 1) % NUM_SAMPLES;
      if (spo2Count < NUM_SAMPLES) spo2Count++;

      lastSpO2 = getAverageSpO2();
    }

    irMax = 0; irMin = 65535;
    redMax = 0; redMin = 65535;
    lastRangeUpdate = millis();
  }
}

void detectBeat(uint16_t irValue) {
  if (thresholdHigh == 0) return;

  if (irValue > thresholdHigh && !peakDetected) {
    peakDetected = true;
    if (t1 == 0) {
      t1 = millis();
    } else {
      t2 = millis();
      unsigned long deltaT = t2 - t1;
      if (deltaT > 300 && deltaT < 2000) {
        float BPM = 60000.0 / deltaT;
        bpmReadings[bpmIndex] = BPM;
        bpmIndex = (bpmIndex + 1) % NUM_SAMPLES;
        if (bpmCount < NUM_SAMPLES) bpmCount++;
        lastBPM = getAverageBPM();
      }
      t1 = t2;
    }
  }

  if (irValue < thresholdLow) {
    peakDetected = false;
  }
}

void handleHeartRate() {
  if (!hrSensorOk) return;

  uint16_t irValue, redValue;
  int drainCount = 0;

  while (readMaxFifoSample(&irValue, &redValue)) {
    drainCount++;
    if (drainCount > 20) {
      Serial.println("[warn] drain loop hit cap of 20 - breaking out");
      break;
    }

    if (irValue < FINGER_THRESHOLD) {
      if (fingerPresent) {
        resetDetection();
        lastBPM = 0;
        lastSpO2 = 0;
      }
      fingerPresent = false;
    } else {
      fingerPresent = true;
      updateRange(irValue, redValue);
      detectBeat(irValue);
    }
  }
}

// ---------------- OLED display manager ----------------
void splitFloat(float value, int &whole, int &frac) {
  whole = (int)value;
  frac = (int)((value - whole) * 10);
  if (frac < 0) frac = -frac;
}

void drawScreen1() {
  u8g2.clearBuffer();

  if (alarmActive) {
    u8g2.setFont(u8g2_font_7x13B_tf);
    u8g2.drawStr(X_OFFSET + 0, 24, "FALL DETECTED");
    u8g2.setFont(u8g2_font_6x10_tf);
    u8g2.drawStr(X_OFFSET + 0, 44, "Alarm active...");
    u8g2.sendBuffer();
    return;
  }

  u8g2.setFont(u8g2_font_7x13B_tf);
  u8g2.drawStr(X_OFFSET + 0, 14, "Critical Info");
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(X_OFFSET + 0, 30, sosActive ? "Status: SOS ACTIVE" : "Status: NORMAL");

  char hrLine[24];
  if (!hrSensorOk) {
    snprintf(hrLine, sizeof(hrLine), "HR sensor unavailable");
  } else if (!fingerPresent) {
    snprintf(hrLine, sizeof(hrLine), "No finger detected");
  } else {
    int bpmW, bpmF, spo2W, spo2F;
    splitFloat(lastBPM, bpmW, bpmF);
    splitFloat(lastSpO2, spo2W, spo2F);
    snprintf(hrLine, sizeof(hrLine), "HR:%d.%d SpO2:%d.%d", bpmW, bpmF, spo2W, spo2F);
  }
  u8g2.drawStr(X_OFFSET + 0, 44, hrLine);
  u8g2.drawStr(X_OFFSET + 0, 58, "Battery: --");
  u8g2.sendBuffer();
}

