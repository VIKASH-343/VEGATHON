    case 1: drawScreen1(); break;
    case 2: drawScreen2(); break;
    case 3: drawScreen3(); break;
    case 4: drawScreen4(); break;
  }
}

void handleButtonAndDisplay() {
  bool currentButtonState = digitalRead(OLED_BUTTON_PIN);

  if (currentButtonState == LOW && lastOledButtonState == HIGH) {
    lastActivity = millis();
    if (!displayAwake) {
      u8g2.setPowerSave(0);
      displayAwake = true;
      showCurrentScreen();
      Serial.println("Display woke up");
    } else {
      currentScreen++;
      if (currentScreen > 4) currentScreen = 1;
      showCurrentScreen();
      Serial.print("Showing screen ");
      Serial.println(currentScreen);
    }
    delay(200);
  }
  lastOledButtonState = currentButtonState;

  if (alarmActive && !displayAwake) {
    u8g2.setPowerSave(0);
    displayAwake = true;
    currentScreen = 1;
    lastActivity = millis();
  }

  if (displayAwake && !alarmActive && (millis() - lastActivity > SLEEP_TIMEOUT)) {
    u8g2.setPowerSave(1);
    displayAwake = false;
    Serial.println("Display sleeping (30s idle)");
  }

  if (displayAwake && (currentScreen == 1 || alarmActive) &&
      (millis() - lastOledUpdate >= OLED_UPDATE_INTERVAL_MS)) {
    showCurrentScreen();
    lastOledUpdate = millis();
  }
}

// ---------------- Send one telemetry packet over LoRa ----------------
void sendTelemetry() {
  float temperature, humidity;
  int result = readDHT11(&temperature, &humidity);

  if (result != 0) {
    if (result == -1) Serial.println("[aries] DHT11 read timeout - check wiring");
    if (result == -2) Serial.println("[aries] DHT11 checksum error");
    return;
  }

  String tempStatus = classifyLevel(temperature,
                         TEMP_EMERGENCY_LOW, TEMP_CRITICAL_LOW, TEMP_WARNING_LOW,
                         TEMP_WARNING_HIGH, TEMP_CRITICAL_HIGH, TEMP_EMERGENCY_HIGH);
  String humStatus = classifyLevel(humidity,
                         HUM_EMERGENCY_LOW, HUM_CRITICAL_LOW, HUM_WARNING_LOW,
                         HUM_WARNING_HIGH, HUM_CRITICAL_HIGH, HUM_EMERGENCY_HIGH);
  Serial.print("[aries] Temp: "); Serial.print(temperature);
  Serial.print(" C ["); Serial.print(tempStatus);
  Serial.print("]  Hum: "); Serial.print(humidity);
  Serial.print(" % ["); Serial.print(humStatus); Serial.println("]");

  float aqInstantPPM, aqTwaPPM;
  String aqMode = readMQ135(&aqInstantPPM, &aqTwaPPM);

  Serial.print("[aries] AQ instant: "); Serial.print(aqInstantPPM, 1);
  Serial.print(" ppm  TWA("); Serial.print(twaCount); Serial.print("/");
  Serial.print(TWA_BUFFER_SIZE); Serial.print("): "); Serial.print(aqTwaPPM, 1);
  Serial.print(" ppm  AQMODE: "); Serial.println(aqMode);

  Serial.print("[aries] SOS: "); Serial.println(sosActive ? "1 (ACTIVE)" : "0");
  Serial.print("[aries] FALL: "); Serial.println(alarmActive ? "1 (ACTIVE)" : "0");

  bool hrDataValid = hrSensorOk && fingerPresent && bpmCount > 0;
  bool spo2DataValid = hrSensorOk && fingerPresent && spo2Count > 0;

  if (hrDataValid) {
    Serial.print("[aries] HR avg: "); Serial.print(lastBPM, 1);
    Serial.print(" bpm  SpO2 avg: "); Serial.print(lastSpO2, 1);
    Serial.println(" %");
  }

  seqNum++;

  String payload = "";
  payload += "VER:"     + String(PROTOCOL_VERSION);
  payload += ",BOOT:"   + String(bootId);
  payload += ",SEQ:"    + String(seqNum);
  payload += ",ID:"     + String(WORKER_ID);
  payload += ",NAME:"   + String(WORKER_NAME);
  payload += ",UPTIME:" + String(millis());
  payload += ",AUTH:"   + String(AUTH_TOKEN);
  payload += ",TEMP:"   + floatToStr(temperature, 1);
  payload += ",HUM:"    + floatToStr(humidity, 1);
  payload += ",AQPPM:"  + floatToStr(aqInstantPPM, 1);
  payload += ",AQTWA:"  + floatToStr(aqTwaPPM, 1);
  payload += ",AQMODE:" + aqMode;
  payload += ",SOS:"    + String(sosActive ? 1 : 0);
  payload += ",FALL:"   + String(alarmActive ? 1 : 0);

  if (hrDataValid)   payload += ",HR:"   + floatToStr(lastBPM, 0);
  if (spo2DataValid) payload += ",SPO2:" + floatToStr(lastSpO2, 0);

  char crcHex[3];
  sprintf(crcHex, "%02X", crc8(payload));
  String packet = payload + ",CRC:" + String(crcHex) + "\n";

  LORA_SERIAL.print(packet);

  Serial.print("[aries] TX: ");
  Serial.print(packet);
}

void setup() {
  Serial.begin(115200);
  LORA_SERIAL.begin(LORA_BAUD);
  delay(2000);  // USB attach + DHT11 stabilize

  pinMode(DHTPIN, INPUT);
  pinMode(BUZZERPIN, OUTPUT);
  pinMode(BUTTONPIN, INPUT_PULLUP);
  digitalWrite(BUZZERPIN, LOW);
  pinMode(OLED_BUTTON_PIN, INPUT_PULLUP);
  pinMode(ALARM_PIN, OUTPUT);
  digitalWrite(ALARM_PIN, LOW);

  if (RUN_CALIBRATION) {
    calibrateR0();
    while (true) { delay(1000); }
  }

  randomSeed(analogRead(A0));
  bootId = (uint32_t)millis() ^ (uint32_t)random(0, 100000);

  Wire.begin();
  Wire.setClock(100000);

  // ---- ADXL345 init (non-fatal) ----
  Serial.print("Checking ADXL345...");
  uint8_t devId = readRegister(REG_DEVID);
  if (devId == ADXL345_DEVID_EXPECTED) {
    adxlOk = true;
    Serial.println("SUCCESS");
    writeRegister(REG_POWER_CTL, 0x08);
    writeRegister(REG_DATA_FORMAT, 0x00);
    writeRegister(REG_BW_RATE, 0x0A);
    calibrateVerticalAxis();
  } else {
    Serial.print("FAILED -- DEVID 0x");
    Serial.print(devId, HEX);
    Serial.println(" (expected 0xE5). Fall detection disabled for this run.");
  }
  lastAccelSampleMs = millis();

  // ---- MAX30100 init (non-fatal) ----
  Serial.print("Initializing MAX30100...");
  hrSensorOk = sensor.begin();
  if (!hrSensorOk) {
    Serial.println("FAILED");
    Serial.print("Part ID read: 0x");
    Serial.println(sensor.getPartId(), HEX);
    Serial.println("HR/SPO2 disabled for this run -- other telemetry continues normally.");
  } else {
    Serial.println("SUCCESS");

    // Soft-reset to clear any stuck FIFO/overflow state
    Wire.beginTransmission(MY_MAX30100_ADDR);
    Wire.write(0x06);
    Wire.write(0x40);
    Wire.endTransmission();
    delay(100);

    sensor.setMode(MAX30100_MODE_SPO2_HR);
    sensor.setLedsCurrent(MAX30100_LED_CURR_24MA, MAX30100_LED_CURR_27_1MA);
    sensor.setLedsPulseWidth(MAX30100_SPC_PW_1600US_16BITS);
    sensor.setSamplingRate(MAX30100_SAMPRATE_100HZ);
    sensor.setHighresModeEnabled(true);
    lastRangeUpdate = millis();

    uint16_t flushIr, flushRed;
    int flushed = 0;
    while (readMaxFifoSample(&flushIr, &flushRed) && flushed < 32) flushed++;
    Serial.print("[init] Flushed ");
    Serial.print(flushed);
    Serial.println(" stale FIFO samples before starting normal operation.");
  }

  u8g2.begin();
  lastActivity = millis();
  showCurrentScreen();

  Serial.println("[aries] Unified worker safety node ready.");
}

void loop() {
  checkSosButton();  // non-blocking, always responsive

  if (hrSensorOk) {
    clearInterruptStatus();
    handleHeartRate();
  }

  if (adxlOk) {
    float gx, gy, gz;
    readAccel(gx, gy, gz);
    float sv = sqrt(gx * gx + gy * gy + gz * gz);
    float verticalReading = (verticalAxisIndex == 0) ? gx : (verticalAxisIndex == 1) ? gy : gz;

    unsigned long now = millis();
    float dt = (now - lastAccelSampleMs) / 1000.0;
    lastAccelSampleMs = now;

    switch (fallState) {
      case PRE_FALL:
        velocityIntegral = 0;
        if (sv < LFT_G) {
          fallState = CRITICAL_PHASE;
          troughMs = now;
          Serial.println(">>> SV dropped below LFT -- critical phase started");
        }
        break;

      case CRITICAL_PHASE:
        velocityIntegral += (sv - 1.0) * dt;
        if (sv > UFT_G) {
          Serial.println(">>> Impact: SV exceeded UFT -- starting posture check");
          fallState = POST_IMPACT_POSTURE_CHECK;
          postureCheckStartMs = now;
        } else if (now - troughMs > IMPACT_WINDOW_MS) {
          Serial.println("No impact within window -- resetting to PRE_FALL");
          fallState = PRE_FALL;
        }
        break;

      case POST_IMPACT_POSTURE_CHECK:
        if (fabs(verticalReading - verticalBaseline) < POSTURE_CHANGE_THRESHOLD_G) {
          postureCheckStartMs = now;
        }
        if (now - postureCheckStartMs >= POSTURE_HOLD_MS) {
          digitalWrite(ALARM_PIN, HIGH);
          alarmActive = true;
          Serial.println("*** FALL DETECTED ***");
          postureCheckStartMs = now;
          fallState = PRE_FALL;
        }
        break;
    }

    static unsigned long alarmStartMs = 0;
    if (alarmActive && alarmStartMs == 0) alarmStartMs = now;
    if (alarmActive && (now - alarmStartMs >= 10000)) {
      digitalWrite(ALARM_PIN, LOW);
      alarmActive = false;
      alarmStartMs = 0;
    }
  }

  handleButtonAndDisplay();

  if (millis() - lastTelemetryTime >= TELEMETRY_INTERVAL_MS) {
    lastTelemetryTime = millis();
    sendTelemetry();
  }

  delay(10);
}




// ESP32 code

/*
 * E220-900T22D (LoRa)  --->  ESP32  --->  WiFi TCP  --->  VEGA dashboard
 * -----------------------------------------------------------------------
 * Receives LoRa packets already in the dashboard's wire format (see
 * aries_v2_lora_sender.ino / protocol.py) and forwards each line, as-is,
 * to tcp_server.py's newline-delimited TCP listener. No parsing or
 * re-encoding happens here on purpose -- the packet, its CRC, and its
 * meaning are the sender's and the server's business, not the bridge's.
 *
 * Wiring:
 *   E220 TX  -> ESP32 GPIO16 (UART2 RX)
 *   E220 RX  -> ESP32 GPIO17 (UART2 TX)
 *   E220 VCC -> 3.3V, GND -> GND
 *   E220 M0  -> GND   (transparent transmission mode)
 *   E220 M1  -> GND
 *   (Same channel/network address as the Aries module -- see the
 *   one-time config note in aries_v2_lora_sender.ino.)
 *
 * DIAGNOSTIC: prints a running count of raw bytes seen on LoRaSerial every
 * 3 seconds, so you can tell "nothing arriving" (wiring/radio problem)
 * apart from "bytes arriving but never forming a clean line" (baud/framing
 * problem) even before a single full packet is ever relayed. Remove the
 * byteCount block once relaying is confirmed working.
 */

#include <WiFi.h>
#include <HardwareSerial.h>

// ---------------- WiFi ----------------
const char* WIFI_SSID = "name";
const char* WIFI_PASS = "passward";

// ---------------- Dashboard server (config.py: TCP_HOST/TCP_PORT) ----------------
const char*    SERVER_HOST = "10.155.66.73";  // IP of the machine running app.py
const uint16_t SERVER_PORT = 5050;

// ---------------- LoRa UART ----------------
HardwareSerial LoRaSerial(2);
#define LORA_RX_PIN 16
#define LORA_TX_PIN 17
#define LORA_BAUD   9600   // must match the Aries sender's LORA_BAUD exactly

WiFiClient client;
String lineBuf = "";

void connectWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("[esp32] connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("[esp32] WiFi connected, IP: ");
  Serial.println(WiFi.localIP());
}

void ensureServerConnection() {
  if (client.connected()) return;
  Serial.println("[esp32] connecting to dashboard TCP server...");
  if (client.connect(SERVER_HOST, SERVER_PORT)) {
    Serial.println("[esp32] connected to dashboard");
  } else {
    Serial.println("[esp32] connection failed, will retry");
  }
}

void setup() {
  Serial.begin(115200);
  LoRaSerial.begin(LORA_BAUD, SERIAL_8N1, LORA_RX_PIN, LORA_TX_PIN);
  connectWiFi();
  ensureServerConnection();
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }
  ensureServerConnection();

  // ---- DIAGNOSTIC: raw byte counter (remove once relaying is confirmed) ----
  static unsigned long lastByteDebug = 0;
  static unsigned long byteCount = 0;
  if (millis() - lastByteDebug > 3000) {
    Serial.print("[esp32] bytes received on LoRaSerial in last 3s: ");
    Serial.println(byteCount);
    byteCount = 0;
    lastByteDebug = millis();
  }
  // ---------------------------------------------------------------------

  // Drain whatever the LoRa module has received and relay complete lines.
  while (LoRaSerial.available()) {
    byteCount++;
    char c = LoRaSerial.read();
    if (c == '\n') {
      lineBuf.trim();
      if (lineBuf.length() > 0) {
        Serial.print("[esp32] relaying: ");
        Serial.println(lineBuf);
        if (client.connected()) {
          client.print(lineBuf);
          client.print("\n");  // tcp_server.py splits incoming data on '\n'
        }
      }
      lineBuf = "";
    } else if (c != '\r') {
      lineBuf += c;
      if (lineBuf.length() > 512) lineBuf = "";  // guard against a stuck/garbled stream
    }
  }

  delay(10);
}
