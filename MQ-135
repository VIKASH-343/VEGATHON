const int MQ135_PIN = 34;

// ---- Circuit constants ----
const float VCC = 3.3;      // Supply voltage to sensor (3.3 or 5.0)
const float RL = 10.0;      // Load resistor on MQ135 module, in kΩ (check your board, often 10k or 20k)

// ---- Calibration constant ----
// R0 = sensor resistance in CLEAN AIR. You must calibrate this once (see note below).
float R0 = 76.63;           // <-- placeholder, replace with YOUR calibrated value

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
}

void loop() {
  int rawADC = readAverageADC(MQ135_PIN, 10);
  float voltage = rawADC * (VCC / 4095.0);

  // Avoid divide-by-zero if voltage is 0
  float RS = 999999;
  if (voltage > 0.01) {
    RS = ((VCC - voltage) / voltage) * RL;
  }

  float ratio = RS / R0;

  Serial.print("ADC: ");
  Serial.print(rawADC);
  Serial.print("  V: ");
  Serial.print(voltage, 3);
  Serial.print("  RS: ");
  Serial.print(RS, 2);
  Serial.print(" kΩ  Ratio(RS/R0): ");
  Serial.println(ratio, 3);

  delay(1000);
}

int readAverageADC(int pin, int samples) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(5);
  }
  return sum / samples;
}



