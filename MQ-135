const int MQ135_PIN = 34;

// ---- Circuit constants ----
const float VCC = 3.3;
const float RL = 10.0;      // kΩ, check your module's load resistor

// ---- Calibration ----
float R0 = 76.63;           // <-- YOUR calibrated value from clean-air test

// ---- CO2 curve constants (datasheet power curve) ----
const float PARA = 116.6020682;
const float PARB = -2.769034857;

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
}

void loop() {
  int rawADC = readAverageADC(MQ135_PIN, 10);
  float voltage = rawADC * (VCC / 4095.0);

  float RS = 999999;
  if (voltage > 0.01) {
    RS = ((VCC - voltage) / voltage) * RL;
  }

  float ratio = RS / R0;
  float ppm = PARA * pow(ratio, PARB);

  String quality = getAirQuality(ppm);

  Serial.print("ADC: ");
  Serial.print(rawADC);
  Serial.print("  RS: ");
  Serial.print(RS, 2);
  Serial.print("  Ratio: ");
  Serial.print(ratio, 3);
  Serial.print("  CO2 PPM: ");
  Serial.print(ppm, 1);
  Serial.print("  Air Quality: ");
  Serial.println(quality);

  delay(1000);
}

int readAverageADC(int pin, int samples) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(5);
  }
  return sum / samples;
}

String getAirQuality(float ppm) {
  if (ppm < 800) {
    return "GOOD";
  } else if (ppm < 1200) {
    return "MODERATE";
  } else if (ppm < 2000) {
    return "POOR";
  } else {
    return "BAD / HAZARDOUS";
  }
}



