/*
 * E220-900T22D (LoRa)  --->  ESP32  --->  WiFi TCP  --->  VEGA dashboard
 * -----------------------------------------------------------------------
 * Receives LoRa packets already in the dashboard's wire format (see
 * aries_v2_lora_sender.ino / protocol.py) and forwards each line, as-is,
 * to tcp_server.py's newline-delimited TCP listener. No parsing or
 * re-encoding happens here on purpose -- the packet, its CRC, and its
 * meaning are the sender's and the server's business, not the bridge's.
 *
 * Wiring:
 *   E220 TX  -> ESP32 GPIO16 (UART2 RX)
 *   E220 RX  -> ESP32 GPIO17 (UART2 TX)
 *   E220 VCC -> 3.3V, GND -> GND
 *   E220 M0  -> GND   (transparent transmission mode)
 *   E220 M1  -> GND
 *   (Same channel/network address as the Aries module -- see the
 *   one-time config note in aries_v2_lora_sender.ino.)
 *
 * DIAGNOSTIC: prints a running count of raw bytes seen on LoRaSerial every
 * 3 seconds, so you can tell "nothing arriving" (wiring/radio problem)
 * apart from "bytes arriving but never forming a clean line" (baud/framing
 * problem) even before a single full packet is ever relayed. Remove the
 * byteCount block once relaying is confirmed working.
 */

#include <WiFi.h>
#include <HardwareSerial.h>

// ---------------- WiFi ----------------
const char* WIFI_SSID = "name";
const char* WIFI_PASS = "passward";

// ---------------- Dashboard server (config.py: TCP_HOST/TCP_PORT) ----------------
const char*    SERVER_HOST = "10.155.66.73";  // IP of the machine running app.py
const uint16_t SERVER_PORT = 5050;

// ---------------- LoRa UART ----------------
HardwareSerial LoRaSerial(2);
#define LORA_RX_PIN 16
#define LORA_TX_PIN 17
#define LORA_BAUD   9600   // must match the Aries sender's LORA_BAUD exactly

WiFiClient client;
String lineBuf = "";

void connectWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("[esp32] connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("[esp32] WiFi connected, IP: ");
  Serial.println(WiFi.localIP());
}

void ensureServerConnection() {
  if (client.connected()) return;
  Serial.println("[esp32] connecting to dashboard TCP server...");
  if (client.connect(SERVER_HOST, SERVER_PORT)) {
    Serial.println("[esp32] connected to dashboard");
  } else {
    Serial.println("[esp32] connection failed, will retry");
  }
}

void setup() {
  Serial.begin(115200);
  LoRaSerial.begin(LORA_BAUD, SERIAL_8N1, LORA_RX_PIN, LORA_TX_PIN);
  connectWiFi();
  ensureServerConnection();
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }
  ensureServerConnection();

  // ---- DIAGNOSTIC: raw byte counter (remove once relaying is confirmed) ----
  static unsigned long lastByteDebug = 0;
  static unsigned long byteCount = 0;
  if (millis() - lastByteDebug > 3000) {
    Serial.print("[esp32] bytes received on LoRaSerial in last 3s: ");
    Serial.println(byteCount);
    byteCount = 0;
    lastByteDebug = millis();
  }
  // ---------------------------------------------------------------------

  // Drain whatever the LoRa module has received and relay complete lines.
  while (LoRaSerial.available()) {
    byteCount++;
    char c = LoRaSerial.read();
    if (c == '\n') {
      lineBuf.trim();
      if (lineBuf.length() > 0) {
        Serial.print("[esp32] relaying: ");
        Serial.println(lineBuf);
        if (client.connected()) {
          client.print(lineBuf);
          client.print("\n");  // tcp_server.py splits incoming data on '\n'
        }
      }
      lineBuf = "";
    } else if (c != '\r') {
      lineBuf += c;
      if (lineBuf.length() > 512) lineBuf = "";  // guard against a stuck/garbled stream
    }
  }

  delay(10);
}
